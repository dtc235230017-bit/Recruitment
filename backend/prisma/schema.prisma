generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  fullName     String
  role         String     // DEPARTMENT, HR_SPECIALIST, HIRING_MANAGER, HR_DIRECTOR
  department   String?
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model JobRequisition {
  id            String        @id @default(uuid())
  code          String        @unique
  title         String
  department    String
  headcount     Int           @default(1)
  isCritical    Boolean       @default(false)
  requirements  String
  jdContent     String?
  cvTemplateUrl String        @default("/mau-cv-chuan.doc")
  salaryRange   String        @default("Thỏa thuận")
  status        String        @default("HR_CHECKING")
  feedbackNote  String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]
}

model Application {
  id                String         @id @default(uuid())
  trackingCode      String         @unique
  jobId             String
  candidateName     String
  candidateEmail    String?        // Không bắt buộc nhập
  candidatePhone    String         // Bắt buộc nhập để gửi SMS
  experience        String
  skills            String
  cvUrl             String
  aiMatchScore      Int?
  aiRank            Int?
  interviewSchedule String?
  interviewNotice   String?
  interviewScore    String?
  emailSentLog      String?        // Lưu log gửi thông báo (Email & SĐT hoặc chỉ SĐT)
  currentStage      String         @default("APPLIED")
  updatedAt         DateTime       @updatedAt
  createdAt         DateTime       @default(now())

  job               JobRequisition @relation(fields: [jobId], references: [id])
  logs              AuditLog[]
}

model AuditLog {
  id            String      @id @default(uuid())
  applicationId String
  actorId       String?
  actorName     String
  fromStage     String
  toStage       String
  comment       String?
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id])
  actor         User?       @relation(fields: [actorId], references: [id])
}